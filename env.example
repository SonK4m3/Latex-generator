# AI Configuration
# Options: 'mock', 'anthropic', 'openai', 'sotatek-anthropic', 'sotatek-openai'
# Ghi chú: Nếu bạn là thành viên Sotatek dùng Bifrost proxy, hãy chọn 'sotatek-anthropic' hoặc 'sotatek-openai'
AI_PROVIDER=mock
AI_API_KEY=your_api_key_here
AI_MODEL= # Leave empty to use default model for the provider
AI_BASE_URL= # Leave empty for default URL. Use for custom endpoints like Groq/OpenRouter
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=8192

# --- Cấu hình riêng cho Sotatek Proxy ---
# Yêu cầu bắt buộc NẾU bạn sử dụng AI_PROVIDER=sotatek-anthropic hoặc sotatek-openai
# GIT_REMOTE=git@github.com:sota-labs/notex-interface.git


# Compile Service
COMPILE_SERVICE_URL=http://localhost:8080

# Limits & Timeout
MAX_REPAIR_ATTEMPTS=3
MAX_INPUT_CHARS=20000
MAX_SOURCE_FILES=10
MAX_SOURCE_CHARS=100000
REQUEST_TIMEOUT_MS=60000
RATE_LIMIT_PER_MINUTE=10
MAX_UPLOAD_BYTES=15728640 # 15MB

# Storage
DATA_DIR=.data

# OCR Configuration
OCR_ENABLED=true
OCR_LANGS=vie+eng
# TESSERACT_CACHE_DIR= # Optional, defaults to OS tmpdir if not set

# Deployment (Docker/Caddy)
# SITE_ADDRESS=yourdomain.com # Set this without scheme to automatically enable Let's Encrypt TLS in production

# MCP is opt-in and disabled by default. These URLs are not a hosted ChatGPT connection.
MCP_ENABLED=false
# Required only when MCP_ENABLED=true; leave empty while disabled.
#   Local dev server (NODE_ENV=development): http://localhost:3001/api/mcp
#   Docker or any non-dev runtime: canonical public HTTPS origin + /api/mcp,
#   e.g. https://notex.example.com/api/mcp. No trailing slash, query, or credentials.
MCP_RESOURCE_URL=
# OAuth client IDs explicitly registered with your Supabase authorization server.
# Required when MCP_ENABLED=true; comma-separated, no spaces needed.
MCP_ALLOWED_CLIENT_IDS=
# Browser origins allowed to call the MCP route, if browser clients are used.
MCP_ALLOWED_ORIGINS=http://localhost:3001
# STORE_BACKEND=supabase is required for durable MCP jobs.
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# MCP_WORKER_SERVICE_ROLE_KEY= # worker container only; never expose to browser/plugin
MCP_PREVIEW_WORKER_ENABLED=false
